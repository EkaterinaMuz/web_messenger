<div class="{{ styles.card }}">
    <main class="{{styles.profile}}">
        {{> ProfileHeader profileHeader}}
        <section class="{{styles.section}}">
            <div class="{{styles.info}}">
                {{#each fields}}
                    {{> InfoCell this}}
                {{/each}}
                <div class="{{styles.actionBlock}}">
                {{> Button
                        label="Save"
                        styles=buttonStyles
                }}
                </div>
            </div>
        </section>
    </main>
</div>
